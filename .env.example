# =====================================================================
# PulseOps AI - Environment Configuration
# =====================================================================

# 1. Database (Neon PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# 2. Notion Integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Jira Cloud
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PHX

# 4. LLM & Embeddings (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# Optional: GEMINI_API_KEY=AIzaxxxxxxxxxxxxx

# 5. Live Search Tool (Tavily)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
